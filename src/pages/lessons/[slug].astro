---
import {getCollection, render} from 'astro:content';
import ArticleWithTitleLayout from '../../layouts/ArticleWithTitleLayout.astro';
import SlidesLayout from '../../layouts/SlidesLayout.astro';

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons
    .toSorted((a, b) => a.id.localeCompare(b.id))
    .filter((lesson) => lesson.data.published)
    .map((lesson) => ({
      params: {slug: lesson.id},
      props: {lesson},
    }));
}

// 2. For your template, you can get the entry directly from the prop
const {lesson} = Astro.props;
const {Content} = await render(lesson);
---

<style>
  /* 2-level lab counters */
  .lesson {
    counter-reset: step;
  }

  .lesson :global(h2:not(.no-step)) {
    counter-increment: step;
    counter-reset: substep;
  }

  .lesson :global(h2:not(.no-step))::before {
    content: 'Step ' counter(step) ': ';
    font-weight: 700;
    margin-right: 0.35rem;
  }

  .lesson :global(h3:not(.no-step)) {
    counter-increment: substep;
  }

  .lesson :global(h3:not(.no-step))::before {
    content: counter(step) '.' counter(substep) ' ';
    font-weight: 700;
    margin-right: 0.35rem;
  }

  /* Make expandable sections visually distinct from surrounding lesson content. */
  .lesson :global(details) {
    --uno: 'my-6 overflow-hidden rounded-xl border border-emerald-600/20 bg-emerald-50/60 shadow-sm dark:border-emerald-300/20 dark:bg-emerald-950/20';
  }

  .lesson :global(details > summary) {
    --uno: 'cursor-pointer px-4 py-3 font-semibold text-emerald-900 transition-colors select-none hover:bg-emerald-100/70 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-emerald-500 dark:text-emerald-100 dark:hover:bg-emerald-900/30';
  }

  .lesson :global(details[open] > summary) {
    --uno: 'mb-4 border-b border-emerald-600/15 bg-emerald-100/45 dark:border-emerald-300/15 dark:bg-emerald-900/20';
  }

  .lesson :global(details > :not(summary)) {
    --uno: 'mx-4';
  }

  .lesson :global(details > :last-child) {
    --uno: 'mb-4';
  }

  /* Nice anchor jump behavior */
  .lesson :global([id]) {
    scroll-margin-top: 96px;
  }

  /* Heading anchor links (rehype-autolink-headings) */
  .lesson :global(.heading-anchor) {
    opacity: 0;
    margin-left: 0.5rem;
    text-decoration: none;
    font-weight: normal;
  }

  .lesson :global(h2:hover .heading-anchor),
  .lesson :global(h3:hover .heading-anchor) {
    opacity: 1;
  }
</style>

{
  lesson.data.type === 'lab' ? (
    <ArticleWithTitleLayout
      title={lesson.data.title}
      description={lesson.data.description ?? ''}
    >
      <div class="lesson">
        <Content />
      </div>
    </ArticleWithTitleLayout>
  ) : (
    <SlidesLayout title={lesson.data.title}>
      <Content />
    </SlidesLayout>
  )
}
